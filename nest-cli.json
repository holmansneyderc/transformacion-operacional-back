{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "manualRestart": true,
    "assets": [
      { "include": "../lib/**/*", "outDir": "dist/lib" },
      { "include": "../generated/**/*", "outDir": "dist/generated" }
    ],
    "watchAssets": true
  },
  "entryFile": "main"
}